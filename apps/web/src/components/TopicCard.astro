---
/**
 * Themenkarte (Figma: Komponente · Themenkarte). Überschrift, Text und ein Link.
 */
interface Props {
  titel: string;
  text: string;
  /** Link-Text und Ziel gehören zusammen und fehlen, solange es die Seite dahinter nicht gibt. */
  link?: string | undefined;
  href?: string | undefined;
  class?: string;
}

const { titel, text, link, href, class: klasse } = Astro.props;
---

<article class:list={['thema', klasse]}>
  <h3 class="text-heading-h3">{titel}</h3>
  <p class="text-body-default">{text}</p>
  {link && href && (
    <a class="text-label-button" {href}>
      {link}
    </a>
  )}
</article>

<style>
  .thema {
    display: grid;
    gap: var(--spacing-md);
    align-content: start;
    justify-items: start;
  }

  p {
    color: var(--text-muted);
  }

  /* 44 px hoch zum Antippen, der Abstand nach oben gleicht die Höhe optisch aus. */
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--sizing-44);
    margin-block: calc(var(--spacing-xs) * -1) calc(var(--spacing-xs) * -1);
    color: var(--text-primary);
  }
</style>
