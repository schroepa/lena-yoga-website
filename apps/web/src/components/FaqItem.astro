---
/**
 * Frage-Eintrag (Figma: Komponente · Frage-Eintrag). Ein <details>, damit es ohne JavaScript auf- und zuklappt.
 */
interface Props {
  frage: string;
  offen?: boolean;
}

const { frage, offen = true } = Astro.props;
---

<details class="frage" open={offen}>
  <summary class="text-heading-h4">{frage}</summary>
  <div class="text-body-default frage__antwort">
    <slot />
  </div>
</details>

<style>
  .frage {
    padding-block: var(--spacing-md);
    border-block-start: 1px solid var(--border-default);
  }

  /* Mindestens 44 px hoch, damit man die Frage auf dem Handy gut trifft. */
  .frage summary {
    display: flex;
    align-items: center;
    min-height: var(--sizing-44);
    padding-block: var(--spacing-3xs);
    cursor: pointer;
  }

  .frage__antwort {
    margin-block-start: var(--spacing-sm);
    color: var(--text-muted);
  }
</style>
