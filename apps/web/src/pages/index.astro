---
/**
 * Startseite (Figma: Start · Mobile und Start · Desktop).
 * Alle Texte stammen aus dem Figma-Entwurf und werden vor dem Livegang mit Lena abgestimmt.
 */
import AudioPlayer from '../components/AudioPlayer.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
import CourseCard from '../components/CourseCard.astro';
import Photo from '../components/Photo.astro';
import PostTeaser from '../components/PostTeaser.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Tag from '../components/Tag.astro';
import heroBild from '../assets/fotos/hero-bogen.jpg';
import kursOnline from '../assets/fotos/kurs-online.jpg';
import kursStudio from '../assets/fotos/kurs-studio.jpg';
import lenaBild from '../assets/fotos/lena-bogen.jpg';
import { hauptaktion } from '../data/navigation';
import Base from '../layouts/Base.astro';

const haltung = [
  {
    titel: 'Alle Körper',
    text: 'Ob groß, klein, kräftig oder steif: Zu jeder Übung zeigt Lena eine Variante für deinen Körper.',
  },
  {
    titel: 'Dein Tempo',
    text: 'Zu jeder Haltung gibt es eine Variante, mit Stuhl oder Kissen.',
  },
  {
    titel: 'Sicherer Raum',
    text: 'In der Gruppe wird nicht verglichen. Wer eine Frage hat, stellt sie.',
  },
];
---

<Base
  title="Lena Yoga | Yoga für alle Körper, online und im Studio"
  description="Lena unterrichtet Yoga online über Sophies Safe Space und im Studio. Die Stunden sind langsam genug, damit jede Person mitkommt."
>
  <div class="container seite">
    <section class="hero" aria-labelledby="hero-titel">
      <div class="hero__text">
        <Tag text="Yoga mit Lena" farbe="butter" />
        <h1 id="hero-titel" class="text-display">
          Yoga für alle Körper, online und im Studio.
        </h1>
        <p class="text-body-large hero__beschreibung">
          Lena unterrichtet Yoga online über Sophies Safe Space und im Studio. Die Stunden sind
          langsam genug, damit jede Person mitkommt.
        </p>
        <div class="knoepfe">
          <Button label={hauptaktion.label} href={hauptaktion.href} />
        </div>
      </div>
      <div class="hero__bild">
        <Photo
          bild={heroBild}
          alt="Lena kniet auf der Yogamatte, die Arme vor der Brust verschränkt und die Augen geschlossen."
          form="bogen"
          breite={520}
          format="hero"
          priority
        />
      </div>
    </section>

    <section class="haltung" aria-label="Haltung">
      {haltung.map((punkt) => (
        <div class="haltung__punkt">
          <h2 class="text-heading-h3">{punkt.titel}</h2>
          <p class="text-body-default">{punkt.text}</p>
        </div>
      ))}
    </section>

    <section class="kurse" aria-labelledby="kurse-titel">
      <SectionHeader
        id="kurse-titel"
        titel="Online oder im Studio"
        text="Lena unterrichtet live im Studio und über Sophies Safe Space."
      />
      <div class="kurse__karten">
        <CourseCard
          bild={kursOnline}
          bildAlt="Lena liegt in einer sanften Rückbeuge auf der Matte, Sonnenlicht fällt durch den Raum."
          tag="Online"
          tagFarbe="sage"
          titel="Yoga online"
          meta="Live über Sophies Safe Space"
          beschreibung="Live von zu Hause aus. Die Kamera kannst du ein- oder ausschalten."
          buttonLabel="Online-Kurse ansehen"
          href="/kurse#kurse-online"
        />
        <CourseCard
          bild={kursStudio}
          bildAlt="Lena steht im Hund mit erhobenem Bein auf der Matte in einem hellen Raum."
          bildAusschnitt="unten"
          tag="Im Studio"
          tagFarbe="butter"
          titel="Yoga vor Ort"
          meta="Kleine Gruppen · Alle Level"
          beschreibung="Ein ruhiger Raum mit Blöcken, Decken, Bolstern und Stühlen."
          buttonLabel="Studio entdecken"
          href="/kurse#kurse-studio"
        />
      </div>
    </section>

    <Band farbe="lilac">
      <div class="meditation__inhalt">
        <div class="meditation__kopf">
          <h2 class="text-heading-h2">Meditationen zum Anhören</h2>
          <p class="text-body-large meditation__text">
            Lena spricht jede Meditation selbst ein. Die Aufnahmen dauern zehn bis fünfzehn Minuten.
          </p>
          <div class="knoepfe">
            <Button stil="ghost" label="Alle Meditationen" href="/meditation" />
          </div>
        </div>
        <AudioPlayer titel="Ankommen im Moment" meta="Meditation · 10 Min" href="/meditation" />
      </div>
    </Band>

    <section class="gedanken" aria-labelledby="gedanken-titel">
      <SectionHeader
        id="gedanken-titel"
        titel="Lenas Gedanken"
        text="Kurze Texte von Lena über Körper, Atem und Alltag."
      />
      <div class="gedanken__beitraege">
        <PostTeaser
          bild={kursOnline}
          bildAlt="Lena liegt in einer sanften Rückbeuge auf der Matte, Sonnenlicht fällt durch den Raum."
          kategorie="Atmen"
          titel="Warum ich in meinen Stunden langsam unterrichte"
          lesezeit="5 Min Lesezeit"
          href="/gedanken"
        />
        <PostTeaser
          bild={kursStudio}
          bildAlt="Lena steht im Hund mit erhobenem Bein auf der Matte in einem hellen Raum."
          bildAusschnitt="unten"
          kategorie="Körper"
          titel="Über den Umgang mit dem eigenen Körper"
          lesezeit="4 Min Lesezeit"
          href="/gedanken"
        />
      </div>
      <div class="knoepfe">
        <Button stil="ghost" label="Alle Gedanken lesen" href="/gedanken" />
      </div>
    </section>

    <Band farbe="inverse">
      <div class="lena__inhalt">
        <div class="lena__bild">
          <Photo
            bild={lenaBild}
            alt="Lena sitzt in einer sanften Drehung auf der Matte und schaut lächelnd ins Licht."
            form="bogen"
            breite={440}
            format="lena"
          />
        </div>
        <div class="lena__text">
          <h2 class="text-heading-h2">Hallo, ich bin Lena.</h2>
          <blockquote class="text-quote">
            <p>„Grenzen sind keine Begrenzungen. Sie schenken uns neuen Raum.“</p>
          </blockquote>
          <p class="text-body-default">
            Ich bin Yogalehrerin und unterrichte Menschen in allen Körperformen. Meine Stunden sind
            langsam und ohne Leistungsdruck.
          </p>
          <div class="knoepfe">
            <Button label="Lena kennenlernen" href="/lena" />
          </div>
        </div>
      </div>
    </Band>

    <Band farbe="highlight">
      <div class="abschluss">
        <h2 class="text-display">Probestunde buchen und Lena kennenlernen.</h2>
        <p class="text-body-large abschluss__text">
          Die erste Stunde ist ein Kennenlernen. Du wählst, ob online über Sophies Safe Space oder
          im Studio.
        </p>
        <div class="knoepfe">
          <Button label={hauptaktion.label} href={hauptaktion.href} />
        </div>
      </div>
    </Band>
  </div>
</Base>

<style>
  /* Abstand zwischen allen Abschnitten: 96 px mobil, 160 px ab Tablet (Figma Start). */
  .seite {
    --abschnittsabstand: var(--spacing-4xl);
    display: grid;
    /* minmax(0, 1fr): Spalte darf schmaler sein als ihr Inhalt, sonst läuft die Seite bei 320 px über. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--abschnittsabstand);
    padding-block: var(--abschnittsabstand) 0;
  }

  /* Knöpfe sind mobil so breit wie die Spalte, ab Tablet so breit wie ihr Text. */
  .knoepfe {
    display: grid;
    justify-items: stretch;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sizing-56);
  }

  .hero__text {
    display: grid;
    gap: var(--spacing-xl);
    justify-items: start;
  }

  .hero__text .knoepfe {
    justify-self: stretch;
  }

  .hero__beschreibung {
    color: var(--text-muted);
  }

  /* Haltung */
  .haltung {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-xl);
  }

  .haltung__punkt {
    display: grid;
    gap: var(--spacing-xs);
    align-content: start;
  }

  .haltung__punkt p {
    color: var(--text-muted);
  }

  /* Kurse und Gedanken */
  .kurse,
  .gedanken {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sizing-56);
  }

  .kurse__karten,
  .gedanken__beitraege {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-2xl);
  }

  /* Meditation */
  .meditation__inhalt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-xl);
  }

  .meditation__kopf {
    display: grid;
    gap: var(--spacing-component-gap-md);
    align-content: start;
  }

  .meditation__text {
    color: var(--text-muted);
  }

  /* Lena */
  .lena__inhalt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-xl);
  }

  .lena__text {
    display: grid;
    gap: var(--spacing-layout-stack-md);
    justify-items: start;
  }

  .lena__text .knoepfe {
    justify-self: stretch;
  }

  .lena__text blockquote {
    margin: 0;
  }

  /* Abschluss */
  .abschluss {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-2xl);
  }

  /* Lange Wörter wie „kennenlernen“ müssen auf schmalen Telefonen umbrechen können. */
  .abschluss h2 {
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .abschluss__text {
    max-width: 42.5rem;
  }

  @media (min-width: 48rem) {
    .seite {
      --abschnittsabstand: var(--spacing-6xl);
      /* Der Fußbereich bringt schon 96 px mit, der Rest ergibt 160 px bis zum Fuß. */
      padding-block-end: calc(var(--abschnittsabstand) - var(--spacing-layout-section-lg));
    }

    .knoepfe,
    .hero__text .knoepfe,
    .lena__text .knoepfe {
      justify-self: start;
      justify-items: start;
    }

    .hero {
      /* Das Foto wird höchstens 520 px breit, auf schmaleren Bildschirmen höchstens 45 %. */
      grid-template-columns: minmax(0, 1fr) min(32.5rem, 45%);
      align-items: center;
      gap: var(--sizing-80);
    }

    .hero__text {
      gap: var(--sizing-40);
    }

    .haltung {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-layout-gutter-lg);
    }

    .kurse,
    .gedanken {
      gap: var(--sizing-72);
    }

    .kurse__karten,
    .gedanken__beitraege {
      grid-template-columns: 1fr 1fr;
    }

    .meditation__inhalt {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .lena__inhalt {
      grid-template-columns: min(27.5rem, 45%) minmax(0, 1fr);
      align-items: center;
    }

    .abschluss {
      gap: var(--spacing-3xl);
    }
  }
</style>
