---
import Base from '../layouts/Base.astro';
---

<Base
  title="Lena Yoga | Yoga für alle Körper, online und im Studio"
  description="Lena unterrichtet Yoga online über Sophies Safe Space und im Studio. Die Stunden sind langsam genug, damit jede Person mitkommt."
>
  <section class="hero container">
    <div class="hero__inhalt">
      <h1 class="text-display">Yoga für alle Körper, online und im Studio.</h1>
      <p class="text-body-large">
        Lena unterrichtet Yoga online über Sophies Safe Space und im Studio. Die Stunden sind
        langsam genug, damit jede Person mitkommt.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--spacing-layout-section-lg);
  }

  .hero__inhalt {
    display: grid;
    gap: var(--spacing-xl);
    max-width: 52rem;
  }

  .hero p {
    max-width: 40rem;
    color: var(--text-muted);
  }
</style>
