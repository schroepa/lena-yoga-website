# ---------- Öffentliche Seite (apps/web) ----------
# Öffentliche Adresse der Seite (für kanonische Links und Sitemap).
PUBLIC_SITE_URL=https://example.com
# Adresse des CMS. Ohne diese Variable nutzt der Build die Beispieldaten aus src/data/fixtures.
# CMS_URL=https://cms.example.com

# ---------- CMS (apps/cms, Datei apps/cms/.env.local) ----------
# Mindestens 32 Zeichen, zum Beispiel: openssl rand -hex 32
# PAYLOAD_SECRET=
# PostgreSQL, lokal: scripts/db-lokal.sh start
# DATABASE_URL=postgres://lena@127.0.0.1:54329/lena_cms
# Bei Neon die direkte (nicht gepoolte) Verbindung nehmen, ohne "-pooler" im Hostnamen.
# Adressen, die die API aus dem Browser aufrufen dürfen.
# WEB_ORIGIN=http://localhost:4321
# CMS_ORIGIN=http://localhost:3001
# Nach dem Veröffentlichen wird damit ein neuer Build der Seite ausgelöst (Deploy Hook von Cloudflare Pages).
# DEPLOY_HOOK_URL=
# Medien-Speicher (Cloudflare R2, S3-kompatibel). Alles oder nichts: Ohne diese Werte werden Dateien
# lokal gespeichert (nur Entwicklung).
# R2_BUCKET=
# R2_ENDPOINT=https://<kontonummer>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://medien.example.com
