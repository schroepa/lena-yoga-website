{
  "name": "hello-lena-yoga",
  "private": true,
  "version": "0.0.0",
  "description": "Website für Lena Yoga: Astro-Frontend, Inhalte als Dateien, Design-Tokens.",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lena/web dev",
    "build": "pnpm --filter @lena/web build",
    "preview": "pnpm --filter @lena/web preview",
    "lint": "pnpm --filter @lena/web sync && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @lena/web test:e2e",
    "lighthouse": "pnpm build && node scripts/lighthouse-check.mjs",
    "audit": "pnpm audit --audit-level=moderate --prod",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro,json,md,css,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,astro}": "eslint --fix"
  }
}
